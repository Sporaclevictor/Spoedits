rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function realUser() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function isAdmin() { return realUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function priceOf(s) {
      return exists(/databases/$(database)/documents/settings/app)
        ? get(/databases/$(database)/documents/settings/app).data.get('prices', {}).get(s, 500)
        : 500;
    }

    // The first admin account can only be claimed once, in one batch that writes both documents.
    match /meta/setup {
      allow read: if true;
      allow create: if realUser()
        && !exists(/databases/$(database)/documents/meta/setup)
        && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if realUser() && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/meta/setup)
        && existsAfter(/databases/$(database)/documents/meta/setup);
      allow update, delete: if false;
    }

    // Prices, payment options and bank details. Anyone can read, only admins can change.
    match /settings/app {
      allow read: if true;
      allow write: if isAdmin();
    }

    // One document per visitor: free trials, paid credits and ban flag.
    match /users/{uid} {
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function dec(k) {
        return changed().hasOnly(['last', k]) && changed().hasAny([k])
          && resource.data[k] > 0 && request.resource.data[k] == resource.data[k] - 1;
      }
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['free','banned','phone','created','last','cr_passport','cr_enhance','cr_iphone','cr_poster','cr_invoice','cr_idcard','cr_doc'])
        && request.resource.data.free == 2
        && request.resource.data.banned == false
        && request.resource.data.cr_passport == 0 && request.resource.data.cr_enhance == 0
        && request.resource.data.cr_iphone == 0 && request.resource.data.cr_poster == 0
        && request.resource.data.cr_invoice == 0 && request.resource.data.cr_idcard == 0
        && request.resource.data.cr_doc == 0
        && request.resource.data.created == request.time
        && request.resource.data.last == request.time;
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid && resource.data.banned == false
        && request.resource.data.last is timestamp
        && (
          dec('free') || dec('cr_passport') || dec('cr_enhance') || dec('cr_iphone')
          || dec('cr_poster') || dec('cr_invoice') || dec('cr_idcard') || dec('cr_doc')
          || changed().hasOnly(['last'])
          || (changed().hasOnly(['last', 'phone']) && request.resource.data.phone is string && request.resource.data.phone.size() <= 20)
        )
      );
      allow delete: if false;
    }

    // Payment requests. Customers create them at the current price, only admins can confirm them.
    match /payments/{ref} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && ref.matches('SPO-[A-Z0-9]{6}')
        && request.resource.data.keys().hasOnly(['uid','service','amount','status','method','payer','phone','created'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.service in ['passport','enhance','iphone','poster','invoice','idcard','doc']
        && request.resource.data.method in ['bank','whatsapp']
        && request.resource.data.amount == priceOf(request.resource.data.service)
        && request.resource.data.created == request.time
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned == false;
      allow update: if isAdmin() || (
        signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])
        && request.resource.data.claimed is timestamp
      );
      allow delete: if false;
    }
  }
}
